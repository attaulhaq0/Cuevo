{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "noEmit": true,
    "types": ["node"], "paths": { "@cuevo/domain": ["./packages/domain/src/index.ts"], "@cuevo/contracts": ["./packages/contracts/src/index.ts"], "@cuevo/config": ["./packages/config/src/index.ts"] }
  },
  "include": ["apps/api/**/*.ts", "apps/worker/**/*.ts", "packages/domain/**/*.ts", "packages/contracts/**/*.ts", "packages/config/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "apps/web", "packages/ui"]
}
