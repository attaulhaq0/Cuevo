{
  "name": "cuevo",
  "version": "0.1.0",
  "private": true,
  "description": "Cuevo by E Deviser — governed K–12 learning experience platform",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/concurrently/dist/bin/index.js --kill-others-on-fail -n web,api,worker \"npm run dev -w @cuevo/web\" \"npm run dev -w @cuevo/api\" \"npm run dev -w @cuevo/worker\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run && npm run test --workspace=@cuevo/web",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:start": "node --import tsx scripts/start-supabase.ts",
    "db:reset": "supabase db reset --local --network-id cuevo-local",
    "db:test": "supabase test db --local --network-id cuevo-local",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-auth.ts",
    "local:configure": "node --import tsx scripts/configure-local.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "local:bootstrap": "node --import tsx scripts/bootstrap-local.ts",
    "storybook": "storybook dev -p 6006 -c apps/web/.storybook",
    "storybook:build": "storybook build -c apps/web/.storybook --output-dir .local/storybook"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@hookform/resolvers": "5.2.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.90.21",
    "jose": "6.2.12",
    "lucide-react": "0.577.0",
    "motion": "12.38.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.71.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.9",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.5",
    "dotenv": "17.3.1",
    "eslint": "9.39.1",
    "storybook": "10.6.1",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "5.0.3"
  },
  "type": "module"
}
